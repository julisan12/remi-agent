{
  "name": "remi",
  "version": "2.0.0",
  "description": "Remi — Agente Orquestador de Tu Academia",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "postinstall": "npx playwright install chromium --with-deps || echo 'Playwright install failed, browser features limited' && node scripts/setup-python.js || echo 'Python setup skipped'",
    "jobs": "node -e \"import('./src/tasks/jobSearch.js').then(m => m.runJobSearch())\"",
    "ghl": "node mcp/ghl/index.js",
    "whatsapp": "node mcp/whatsapp/index.js",
    "meta": "node mcp/meta/index.js",
    "webhook": "node webhook/server.js",
    "watch": "node scripts/auto-push.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@deepgram/sdk": "^3.13.0",
    "@modelcontextprotocol/sdk": "^1.9.0",
    "@slack/web-api": "^7.15.0",
    "axios": "^1.8.4",
    "baileys": "^6.7.18",
    "docx": "^9.6.1",
    "dotenv": "^16.4.7",
    "express": "^4.18.2",
    "form-data": "^4.0.5",
    "googleapis": "^144.0.0",
    "node-cron": "^3.0.3",
    "openai": "^6.33.0",
    "playwright": "^1.58.2",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.20.0",
    "zod": "^3.22.4"
  }
}
