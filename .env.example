# ─── Anthropic ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Slack ────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...

# ─── Google Sheets ────────────────────────────────────────────
GOOGLE_SHEET_ID=
# JSON completo del Service Account (en una sola línea)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ─── Seguridad ────────────────────────────────────────────────
# Token para triggers manuales vía webhook
REMI_SECRET_TOKEN=remi-secret-cambiame

# Token de autenticación para el MCP Gateway (puerto 3001)
# Todos los miembros del equipo usan este mismo token en sus settings de claude.ai
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REMI_MCP_TOKEN=

# Puerto del MCP Gateway (por defecto 3001)
MCP_PORT=3001

# Token para la app desktop (Remi Desktop)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DESKTOP_API_TOKEN=remi-desktop-cambiame

# Secreto para firmar JWTs de sesión web (OBLIGATORIO en producción)
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=remi-jwt-secret-cambiame

# ─── GHL Cuenta Certificación ─────────────────────────────────
GHL_CERT_API_TOKEN=pit-...
GHL_CERT_LOCATION_ID=...

# ─── Notion ────────────────────────────────────────────────────
NOTION_TOKEN=secret_...

# ─── Voice Mode (Reuniones) ────────────────────────────────────
# STT en tiempo real
DEEPGRAM_API_KEY=

# TTS en streaming
ELEVENLABS_API_KEY=
# Voice ID de ElevenLabs (default: Adam — pNInz6obpgDQGcFmaJgB)
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# ─── Obsidian ──────────────────────────────────────────────────
OBSIDIAN_VAULT=/ruta/a/tu/vault

# ─── Railway (automático) ─────────────────────────────────────
PORT=3000

# ─── OAuth — Google (para integraciones personales por usuario) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL pública del servidor (para callbacks OAuth)
PUBLIC_URL=https://tu-app.railway.app

# ─── OAuth — Notion ─────────────────────────────────────────────
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# ─── OAuth — Slack ──────────────────────────────────────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ─── GitHub API (vault sync bidireccional con Obsidian) ─────────
# Genera un token en github.com/settings/tokens con permiso: repo (contents)
GITHUB_TOKEN=
GITHUB_REPO=tu-usuario/tu-vault

# Sendflow monitor
SENDFLOW_EMAIL=
SENDFLOW_PASSWORD=
SENDFLOW_CAMPAIGNS=[]

# Slack job search
SLACK_WORKSPACE_URL=https://tu-workspace.slack.com
SLACK_JOBS_USER_ID=
SLACK_VENTAS_USER_ID=
SLACK_OPERADOR_USER_ID=
